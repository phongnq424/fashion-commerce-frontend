# Đường dẫn API. Vite chuyển /api/... tới http://localhost:8080 (xem vite.config.js / vite.admin.config.js).
# Cổng 8080 là Backend thật, hoặc BE giả khi chạy `npm run mock` / `npm run demo`.
VITE_API_BASE_URL=/api/v1

# Địa chỉ 2 app (dùng cho link "Xem web mua sắm" trong trang quản trị)
VITE_SHOP_URL=http://localhost:5173
